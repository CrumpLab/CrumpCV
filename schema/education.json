{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "education",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "note": {
        "type": [
          "string",
          "null"
        ]
      },
      "when": {
        "type": "string"
      },
      "degree": {
        "type": "string"
      },
      "field": {
        "type": "string"
      },
      "institution": {
        "type": "string"
      },
      "location": {
        "type": "string"
      },
      "start": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}){0,2}$"
          }
        ]
      },
      "end": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}){0,2}$"
          }
        ]
      },
      "conferred": {
        "type": "string"
      },
      "dissertation": {
        "type": "string"
      },
      "advisor": {
        "type": "string"
      }
    },
    "required": [
      "degree",
      "field",
      "institution",
      "end"
    ],
    "additionalProperties": false
  }
}
