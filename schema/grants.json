{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "grants",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "note": {
        "type": [
          "string",
          "null"
        ]
      },
      "when": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "funder": {
        "type": "string"
      },
      "program": {
        "type": "string"
      },
      "number": {
        "type": "string"
      },
      "amount": {
        "type": "number"
      },
      "amount_note": {
        "type": "string"
      },
      "currency": {
        "type": "string"
      },
      "role": {
        "enum": [
          "PI",
          "Co-PI",
          "Co-I",
          "Senior Personnel"
        ]
      },
      "status": {
        "enum": [
          "funded",
          "submitted",
          "declined"
        ]
      },
      "start": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}){0,2}$"
          }
        ]
      },
      "end": {
        "oneOf": [
          {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1990,
                "maximum": 2100
              },
              {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2}){0,2}$"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "title",
      "funder",
      "role",
      "status",
      "start"
    ],
    "additionalProperties": false
  }
}
