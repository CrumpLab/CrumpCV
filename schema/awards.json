{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "awards",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "note": {
        "type": [
          "string",
          "null"
        ]
      },
      "when": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "organization": {
        "type": "string"
      },
      "year": {
        "type": "integer"
      },
      "start": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}){0,2}$"
          }
        ]
      },
      "end": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}){0,2}$"
          }
        ]
      }
    },
    "required": [
      "title",
      "organization",
      "year"
    ],
    "additionalProperties": false
  }
}
