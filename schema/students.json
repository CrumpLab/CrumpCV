{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "students",
  "type": "object",
  "properties": {
    "mentees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "when": {
            "type": "string"
          },
          "level": {
            "enum": [
              "postdoc",
              "doctoral",
              "masters",
              "undergraduate"
            ]
          },
          "name": {
            "type": "string"
          },
          "surname": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "start": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1990,
                "maximum": 2100
              },
              {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2}){0,2}$"
              }
            ]
          },
          "end": {
            "oneOf": [
              {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1990,
                    "maximum": 2100
                  },
                  {
                    "type": "string",
                    "pattern": "^\\d{4}(-\\d{2}){0,2}$"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "program": {
            "type": "string"
          }
        },
        "required": [
          "level",
          "name",
          "surname"
        ],
        "additionalProperties": false
      }
    },
    "committees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "when": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "student": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          }
        },
        "required": [
          "role",
          "student",
          "institution",
          "year"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "mentees",
    "committees"
  ],
  "additionalProperties": false
}
