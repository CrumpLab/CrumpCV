{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "positions",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "note": {
        "type": [
          "string",
          "null"
        ]
      },
      "when": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "institution": {
        "type": "string"
      },
      "department": {
        "type": "string"
      },
      "location": {
        "type": "string"
      },
      "start": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}){0,2}$"
          }
        ]
      },
      "end": {
        "oneOf": [
          {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1990,
                "maximum": 2100
              },
              {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2}){0,2}$"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "advisor": {
        "type": "string"
      }
    },
    "required": [
      "title",
      "institution",
      "start",
      "end"
    ],
    "additionalProperties": false
  }
}
